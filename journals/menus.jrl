p({
  "class":"foam.core.menu.Menu",
  "id":"cookbook",
  "label":"Cook Book",
  "authenticate":true,
  "handler":{"class":"foam.core.menu.SubMenu","title":"Cook Book"},
  "border":{"class":"foam.u2.borders.NullBorder"}
})

p({
  "class":"foam.core.menu.Menu",
  "id":"cookbook.createRecipe",
  "parent":"cookbook",
  "label":"Create Recipe",
  "order":0,
  "authenticate":true,
  "keywords":["create", "new"],
  "handler":{
    "class":"foam.core.menu.ViewMenu",
    "view":{"class":"com.foamdev.cook.RecipeCreateView3"}
  }
})

p({
  "class":"foam.core.menu.Menu",
  "id":"cookbook.recipe",
  "parent":"cookbook",
  "label":"Recipe",
  "order":1,
  "authenticate":true,
  "keywords":[""],
  "handler":{
    "class":"foam.core.menu.DAOMenu2",
    "config":{
      "class":"foam.comics.v2.DAOControllerConfig",
      "daoKey":"recipeDAO",
      "detailView":{"class":"com.foamdev.cook.RecipeView"}
    }
  }
})



p({
  "class":"foam.core.menu.Menu",
  "id":"cookbook.ingredientAmount",
  "parent":"cookbook",
  "label":"Ingredient Amount",
  "order":2,
  "authenticate":true,
  "keywords":[""],
  "handler":{
    "class":"foam.core.menu.DAOMenu2",
    "config":{
      "class":"foam.comics.v2.DAOControllerConfig",
      "daoKey":"ingredientAmountDAO",
      "createView":{
        "class":"foam.u2.view.FObjectView",
        "detailView":{"class":"foam.u2.detail.TabbedDetailView"}
      }
    }
  }
})

p({
  "class":"foam.core.menu.Menu",
  "id":"cookbook.ingredient",
  "parent":"cookbook",
  "label":"Ingredient",
  "order":3,
  "authenticate":true,
  "keywords":[""],
  "handler":{
    "class":"foam.core.menu.DAOMenu2",
    "config":{
      "class":"foam.comics.v2.DAOControllerConfig",
      "daoKey":"ingredientDAO"
    }
  }
})


